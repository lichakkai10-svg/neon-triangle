 "official_facts": [
  {
   "fact": "Through Zone 最少淨闊 3m（市區）；做唔到三區就最少 3m",
   "src": "HKPSG8 §5.4.21 + Table 8 註[3]"
  },
  {
   "fact": "Table 8：商業/住宅1（極高人流）Through 4.5m；住宅1 3.5m；住宅2/3 3m；鄉郊 2m；General Industrial 4.5m；Special Industrial 3.5m；SF&GZ 2.0m(P1/P2)，大樹 3–4m；Building Frontage 0.5m(P1)/1.0m(P2,P3)",
   "src": "HKPSG8 Table 8（= TPDM V6 Table 10.5.5.1）"
  },
  {
   "fact": "人流分級：Very High >100 人/分鐘；High 81–100；Medium 71–80；Low-Med 61–70；Low <60",
   "src": "TPDM_V2 Table 3.4.11.1"
  },
  {
   "fact": "欄杆係引導／控制行人，唔係擋車；唔好淨係為咗阻泊車而裝；有花槽或凸起中央分隔就唔裝",
   "src": "TPDM_V2 3.9.2.1–3.9.2.4; TC0217 §3–4"
  },
  {
   "fact": "過路處兩邊用 guidance 欄杆引去過路處，長度通常限 6m 一邊",
   "src": "TPDM_V2 3.9.2.10"
  },
  {
   "fact": "人流接近/超過 Through Zone 預計量 → 用 control 欄杆防行出車路；但行人路 <2m 要酌情（裝咗反而更窄）",
   "src": "TPDM_V2 3.9.2.9"
  },
  {
   "fact": "錯位過路處中島用 control 欄杆，要留位等",
   "src": "TPDM_V2 3.9.2.14"
  },
  {
   "fact": "雙程分隔路（區域/地方幹路）冇花槽或凸起中央分隔，可喺中央分隔裝 control 欄杆",
   "src": "TPDM_V2 3.9.2.12"
  },
  {
   "fact": "路口／過路處用唔阻視線嘅欄杆（Type 2 Railings at Junctions and Crossings）；上游約 30m 唔准掛廣告橫額",
   "src": "TPDM_V2 3.9.2.16"
  },
  {
   "fact": "快速路／主要幹路旁唔用行人欄杆，用防撞欄",
   "src": "TPDM_V2 3.9.2.18"
  },
  {
   "fact": "行人路高過旁邊 ≥1.5m 或後面係斜坡 → 一定要 Type 2 control 欄杆",
   "src": "TPDM_V2 3.9.2.7"
  },
  {
   "fact": "橫向淨空（≤50km/h，物件 <3m）：500mm；物件 ≥3m：500–800mm；50–80km/h：600–1000mm；舊路可減至 200mm，行人路有效闊唔夠 1.5m 時用 200mm",
   "src": "TPDM_V2 Table 3.5.2.1, 3.5.2.2, 3.9.2.19"
  },
  {
   "fact": "石墩間距：行人路 ≤2m 用 2.5m；>2m 用 2m；唔好濫用",
   "src": "TPDM_V2 3.9.2.15"
  },
  {
   "fact": "的士站欄杆要加開口",
   "src": "HKPSG8 §4.3.5"
  },
  {
   "fact": "食環署冇公開統一間距；按行人流量、行人路闊度、垃圾量擺；位置：主要行人路口、交通交匯處、巴士站、碼頭；阻街就移位或換細桶",
   "src": "FEHD2016; FEHD_CW_DC2017"
  },
  {
   "fact": "九龍城區約 586 個廢屑箱＋47 個煙蒂箱（2026-09）；中西區 2016 年約 1200 個，2015–16 年減約 15%",
   "src": "FEHD_KC_DC2026; FEHD_CW_DC2017; FEHD2016"
  },
  {
   "fact": "政策方向：減廢屑箱；放十字路口、場地出入口等策略位置",
   "src": "LEGCO_BIN_RATIO_2019"
  },
  {
   "fact": "市區路邊三色回收箱 2022 年底前移除",
   "src": "LEGCO_KERBSIDE_RECYCLE_2024"
  }
 ],
 "estimates_zh": "design_estimate／非官方·遊戲建議：每條街實際行人路闊度、桶間距（40/45/50/60m，跟政府 40–60m 建議）、每 100m 上限、欄杆覆蓋 %、Lite 數、snap 規則、車路口缺口。官方：欄杆高 1.0m、柱距 ≤1.5m、直枝 ≤125mm、離車路 500mm（最少 200）、過路處每邊 6m（遊戲當最少）、kerb 125mm、Through Zone 4.5/3.5/3m、巴士站 13/26/39m、桶 70/130L。",
